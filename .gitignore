# ── Local only, never published ─────────────────────────────────
# Both stay on the instructor's machine. Listing them here does NOT
# remove them from disk — only from what gets pushed.

# The complete solution to every project. Regenerate with:
#     python3 .tools/stagegen.py --check
instructor/

# The previous version of the course materials, superseded by the
# generated topic folders. Kept locally for reference only.
legacy/

# The authoring system: the annotated master compiler that every topic
# folder is cut from, the content sources for the course site, and the
# generators. Instructor-only.
.tools/

# Notes for whoever teaches this, and the git directory of the private
# instructor repository that shares this working directory.
INSTRUCTOR.md
.git-instructor/
